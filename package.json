{
  "name": "thin-muscle-club",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tmc/web",
    "dev:server": "npm run dev -w @tmc/server",
    "db:up": "docker compose up -d db",
    "build": "npm run build -w @tmc/web && npm run build -w @tmc/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "drizzle-orm": "^0.36.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
