# 复制为 .env 并填写。任意 OpenAI 兼容接口都可以。

# 通义千问（默认）—— 在阿里云百炼控制台创建 API Key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 服务端（apps/server）----
API_PORT=8787
# 本地开发：pglite://./.data/pglite（内嵌，无需 Docker）
# 本地 Docker：postgres://tmc:tmc_dev@localhost:5433/tmc（npm run db:up）
# 线上：腾讯云 PostgreSQL 内网地址
DATABASE_URL=pglite://./.data/pglite
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
CODE_PEPPER=
# console = 验证码打印到服务端日志（开发 / 内测）；生产必须换成 tencent / smtp
SMS_PROVIDER=console
EMAIL_PROVIDER=console
