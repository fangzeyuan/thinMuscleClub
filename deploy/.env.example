# 复制为 deploy/.env 后运行 ./init-env.sh 自动生成密钥，再填写下面标"必填"的项

# 访问地址（必填）：没有域名时用 服务器公网IP.sslip.io，例如 43.128.10.20.sslip.io
DOMAIN=

# 以下三项留空，init-env.sh 会自动生成
POSTGRES_PASSWORD=
JWT_SECRET=
CODE_PEPPER=

NODE_ENV=production

# 登录方式：内测只开邮箱（短信签名需要备案）
SMS_PROVIDER=none
EMAIL_PROVIDER=smtp
# QQ 邮箱：设置 → 账户 → 开启 SMTP 服务 → 生成"授权码"（不是 QQ 密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 内测白名单（必填，逗号分隔）：只有这些邮箱能注册，例如 me@qq.com,friend@163.com
SIGNUP_ALLOWLIST=

# AI 教练（可选）：智谱 / 千问 / DeepSeek 等 OpenAI 兼容接口
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
